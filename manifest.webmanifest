{
  "name": "Beam",
  "short_name": "Beam",
  "description": "Send files and text between your devices, browser to browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f1513",
  "theme_color": "#1f7a55",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
  },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
